# Local Terraform working files
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
tfplan

# Variable values can hold IDs and emails; commit only the example
terraform.tfvars
*.auto.tfvars

# Keep the provider lock file under version control
!.terraform.lock.hcl

# Donor data never goes into git: source workbooks, per-tab CSVs and conversion output
data/source/
data/out/
data/**/*.xlsx
data/**/rejects.csv
__pycache__/
.pytest_cache/
